
#include <stdio.h>
#include <string.h>

int main() {
    unsigned char key = 0x5A;
    char p[] = "ABCDEFGH";
    unsigned char c[8], d[8];
    int i;

    for (i = 0; i < 8; i++)
        c[i] = p[i] ^ key;

    printf("Plaintext: %s\n", p);
    printf("Encrypted: ");
    for (i = 0; i < 8; i++)
        printf("%02X", c[i]);

    for (i = 0; i < 8; i++)
        d[i] = c[i] ^ key;

    printf("\nDecrypted: ");
    for (i = 0; i < 8; i++)
        printf("%c", d[i]);

    printf("\n");
    return 0;
}
