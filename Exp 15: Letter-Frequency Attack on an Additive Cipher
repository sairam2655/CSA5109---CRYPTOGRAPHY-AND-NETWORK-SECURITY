#include <stdio.h>
#include <string.h>
#include <ctype.h>

double freq[] = {8.17,1.49,2.78,4.25,12.70,2.23,2.02,6.09,
                 6.97,0.15,0.77,4.03,2.41,6.75,7.51,1.93,
                 0.10,5.99,6.33,9.06,2.76,0.98,2.36,0.15,1.97,0.07};

int main() {
    char c[1000], p[1000];
    double score[26];
    int shift, i, j, count[26];
    printf("Enter ciphertext: ");
    fgets(c, sizeof(c), stdin);

    for (shift = 0; shift < 26; shift++) {
        for (i = 0; i < 26; i++) count[i] = 0;
        int total = 0;

        for (i = 0; c[i]; i++) {
            if (isalpha((unsigned char)c[i])) {
                char ch = toupper((unsigned char)c[i]);
                p[i] = (ch - 'A' - shift + 26) % 26 + 'A';
                count[p[i] - 'A']++;
                total++;
            } else p[i] = c[i];
        }
        p[i] = '\0';

        score[shift] = 0;
        for (j = 0; j < 26; j++) {
            double expected = freq[j] * total / 100.0;
            if (expected > 0)
                score[shift] += (count[j]-expected)*(count[j]-expected)/expected;
        }
    }

    printf("Tested all 26 shifts. Lower frequency score is better.\n");
    for (shift = 0; shift < 26; shift++)
        printf("Shift %2d: score = %.2f\n", shift, score[shift]);

    return 0;
}
