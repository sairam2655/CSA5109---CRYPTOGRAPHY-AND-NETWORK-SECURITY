#include <stdio.h>
#include <string.h>

int main() {
    char msg[100];
    int n, padded, i;

    printf("Enter message: ");
    fgets(msg, sizeof(msg), stdin);
    n = strcspn(msg, "\n");

    padded = ((n / 8) + 1) * 8;

    printf("Original length: %d bytes\n", n);
    printf("Padded length: %d bytes\n", padded);
    printf("Padding bytes added: %d\n", padded - n);
    return 0;
}
