#include <stdio.h>

int main() {
    int k[2][2] = {{9,4},{5,7}};
    int p[2][2] = {{1,0},{0,1}};
    int i, c1, c2;

    for (i = 0; i < 2; i++) {
        c1 = (k[0][0]*p[i][0] + k[0][1]*p[i][1]) % 26;
        c2 = (k[1][0]*p[i][0] + k[1][1]*p[i][1]) % 26;
        printf("%c%c -> %c%c\n",
               p[i][0]+'A', p[i][1]+'A', c1+'A', c2+'A');
    }

    printf("Recovered key: [9 4; 5 7]\n");
    return 0;
}
