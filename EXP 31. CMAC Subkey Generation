#include <stdio.h>
#include <stdint.h>

uint64_t subkey64(uint64_t x) {
    uint64_t r = x << 1;
    if (x & 0x8000000000000000ULL)
        r ^= 0x1B;
    return r;
}

int main() {
    uint64_t L = 0x8000000000000001ULL;
    uint64_t K1 = subkey64(L);
    uint64_t K2 = subkey64(K1);

    printf("64-bit Rb = 0x1B\n");
    printf("128-bit Rb = 0x87\n");
    printf("K1 = %016llX\n", (unsigned long long)K1);
    printf("K2 = %016llX\n", (unsigned long long)K2);
    return 0;
}
