#include <stdio.h>
#include <math.h>

int main() {
    double keys = 1;
    int i;

    /* 25 letters arranged in a 5x5 matrix */
    for (i = 1; i <= 25; i++)
        keys *= i;

    printf("Possible Playfair keys = 25! = %.0f\n", keys);
    printf("Approximate power of 2 = 2^83\n");
    printf("Effectively unique keys: approximately 2^49\n");

    return 0;
}
