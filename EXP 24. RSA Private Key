#include <stdio.h>

int main() {
    int p = 59, q = 61;
    int n = p * q;
    int phi = (p - 1) * (q - 1);
    int e = 31, d;

    for (d = 1; d < phi; d++)
        if ((e * d) % phi == 1)
            break;

    printf("p = %d, q = %d\n", p, q);
    printf("n = %d\n", n);
    printf("phi(n) = %d\n", phi);
    printf("Public key e = %d\n", e);
    printf("Private key d = %d\n", d);
    return 0;
}
