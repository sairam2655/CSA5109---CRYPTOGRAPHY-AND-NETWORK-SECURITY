#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char p[] = "SENDMOREMONEY";
    int key[] = {9,0,1,7,23,15,21,14,11,11,2,8,9};
    char c[50];
    int i;

    for (i = 0; p[i]; i++)
        c[i] = (p[i] - 'A' + key[i]) % 26 + 'A';
    c[i] = '\0';

    printf("Plaintext: SEND MORE MONEY\n");
    printf("Ciphertext: %s\n", c);
    return 0;
}
