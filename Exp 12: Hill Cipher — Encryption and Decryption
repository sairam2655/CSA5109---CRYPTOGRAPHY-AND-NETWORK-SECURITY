#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char p[] = "MEETMEATTHEUSUALPLACEATTENRATHERTHANEIGHTOCLOCK";
    char c[100], d[100];
    int i, a, b, x, y;

    int k[2][2] = {{9,4},{5,7}};
    int inv[2][2] = {{5,12},{15,25}};

    int n = strlen(p);
    if (n % 2) p[n++] = 'X';
    p[n] = '\0';

    for (i = 0; i < n; i += 2) {
        a = p[i] - 'A';
        b = p[i+1] - 'A';
        c[i]   = (k[0][0]*a + k[0][1]*b) % 26 + 'A';
        c[i+1] = (k[1][0]*a + k[1][1]*b) % 26 + 'A';
    }
    c[n] = '\0';

    for (i = 0; i < n; i += 2) {
        x = c[i] - 'A';
        y = c[i+1] - 'A';
        d[i]   = (inv[0][0]*x + inv[0][1]*y) % 26 + 'A';
        d[i+1] = (inv[1][0]*x + inv[1][1]*y) % 26 + 'A';
    }
    d[n] = '\0';

    printf("Plaintext: %s\n", p);
    printf("Ciphertext: %s\n", c);
    printf("Decrypted: %s\n", d);
    return 0;
}
