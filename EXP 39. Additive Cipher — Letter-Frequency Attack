#include <stdio.h>
#include <ctype.h>

int main() {
    char c[1000];
    int s, i;

    printf("Enter ciphertext: ");
    fgets(c, sizeof(c), stdin);

    for (s = 0; s < 26; s++) {
        printf("Shift %2d: ", s);
        for (i = 0; c[i]; i++) {
            if (isalpha((unsigned char)c[i]))
                putchar((toupper((unsigned char)c[i])-'A'-s+26)%26+'A');
            else putchar(c[i]);
        }
    }
    return 0;
}
